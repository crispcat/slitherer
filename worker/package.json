{
  "name": "slitherer-rag-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute slitherer-rag-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute slitherer-rag-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "ingest": "node scripts/ingest.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "jsonrepair": "^3.15.0"
  }
}
